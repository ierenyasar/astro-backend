# ---------- Zorunlu ----------

# PostgreSQL bağlantısı
DATABASE_URL="postgresql://user:password@localhost:5432/astro?schema=public"

# JWT imzalama anahtarı — production'da uzun, rastgele bir değerle değiştir
JWT_SECRET="change-this-to-a-long-random-secret"

# Anthropic API key — https://console.anthropic.com/
# ASLA client/mobil koda koyma, sadece backend env variable olarak kullan
ANTHROPIC_API_KEY="sk-ant-..."

# Sunucu
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"


# ---------- Geocoding (opsiyonel) ----------
# Nominatim (OpenStreetMap) kullanılıyor, API key gerektirmez ama
# kullanım şartları tanımlayıcı bir User-Agent ister.
GEOCODER_USER_AGENT="AstroApp/1.0 (iletisim@ornek.com)"


# ---------- Abonelik doğrulama ----------
# Bunlar tanımlanmazsa /subscription/verify 503 döner ve HİÇ KİMSE premium olamaz.
# Bu bilinçli bir tercihtir: doğrulama yapılandırılmadan premium verilmez.

# Apple — App Store Connect > Integrations > In-App Purchase
APPLE_ISSUER_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""          # .p8 dosyasının içeriği, satır sonları \n olarak
APPLE_BUNDLE_ID="com.example.astroapp"
APPLE_ENVIRONMENT="sandbox"    # sandbox | production

# Google — Play Console service account key JSON'u (tek satır)
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_PACKAGE_NAME="com.example.astroapp"


# ---------- Mağaza bildirimleri (webhook) ----------
# Bunlar tanımlanmazsa bildirimler doğrulanamaz ve REDDEDİLİR (durum güncellenmez).

# Apple Root CA - G3 sertifikası (PEM), satır sonları 
 olarak
# https://www.apple.com/certificateauthority/ adresinden indirilir
APPLE_ROOT_CA_PEM=""

# Google Pub/Sub push subscription'ındaki service account e-postası
GOOGLE_PUBSUB_SERVICE_ACCOUNT=""
# Push endpoint URL'i (audience olarak yapılandırıldıysa)
GOOGLE_PUBSUB_AUDIENCE=""


# ---------- Push bildirimleri ----------
# Expo hesabında "enhanced security" açıksa gerekir, aksi halde boş bırakılabilir
EXPO_ACCESS_TOKEN=""

# Çok instance'lı kurulumda dahili zamanlayıcıyı kapat, harici cron kullan
DISABLE_NOTIFICATION_SCHEDULER="false"
# /internal/cron/daily-notifications ucunu korur (x-cron-secret header'ı ile)
CRON_SECRET=""

# ---------- Analytics ----------
# /internal/analytics/summary ucunu korur (x-analytics-secret header'ı ile)
ANALYTICS_SECRET=""

# ---------- E-posta (şifre sıfırlama için) ----------
# "resend" | "console" (varsayılan). console modunda e-posta gönderilmez, konsola yazılır.
EMAIL_PROVIDER="console"
EMAIL_FROM="Astro <noreply@ornek.com>"
RESEND_API_KEY=""
# Kullanıcının şifre belirleyeceği web sayfası; ?token=... eklenerek gönderilir
# Backend bu sayfayı kendisi sunar; ayrı site kurmana gerek yok:
PASSWORD_RESET_URL="https://SENIN-BACKEND-ADRESIN/sifre-sifirla"

# ---------- Yönetim ----------
# /internal/notifications/broadcast ucunu korur (x-admin-secret header'ı ile)
ADMIN_SECRET=""
